{
    "info": {
        "_postman_id": "shark-funded-api-collection",
        "name": "Shark Funded API",
        "description": "API collection for Shark Funded application including payment and admin endpoints.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Public API",
            "item": [
                {
                    "name": "System Status",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/system-status",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "system-status"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Payment Flow",
            "item": [
                {
                    "name": "Create Order",
                    "request": {
                        "auth": {
                            "type": "basic",
                            "basic": [
                                {
                                    "key": "password",
                                    "value": "{{auth_pass}}",
                                    "type": "string"
                                },
                                {
                                    "key": "username",
                                    "value": "{{auth_user}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"amount\": 100,\n    \"name\": \"Test User\",\n    \"email\": \"viswanath@sharkfunded.com\",\n    \"callback_url\": \"{{base_url}}/checkout/callback\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/create-order",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "create-order"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Verify Payment",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"utr\": \"TEST12345678\",\n    \"amount\": 100,\n    \"email\": \"viswanath@sharkfunded.com\",\n    \"name\": \"Test User\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/verify-payment",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "verify-payment"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Payment Webhook (Simulated)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"from\": \"HP-SBI\",\n    \"text\": \"Credited Rs. 100.00 to your account linked to UTR 123456789012\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/payment-webhook",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "payment-webhook"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Admin Actions",
            "item": [
                {
                    "name": "Update Transaction Status",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"transactionId\": \"<UUID_OF_TRANSACTION>\",\n    \"status\": \"verified\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/admin/update-status",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "update-status"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Send Receipt",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"utr\": \"123456789012\",\n    \"email\": \"viswanath@sharkfunded.com\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/send-receipt",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "send-receipt"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "auth_user",
            "value": "admin_user",
            "type": "string"
        },
        {
            "key": "auth_pass",
            "value": "admin_pass",
            "type": "string"
        }
    ]
}