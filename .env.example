# PostgreSQL Database Configuration
POSTGRES_URL=postgresql://postgres:password@localhost:5432/sharkpay
# Or individual connection settings:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=sharkpay

# Legacy Supabase Configuration (Optional / Fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shark Payment Configuration
SHARK_PAYMENT_KEY_ID=
SHARK_PAYMENT_KEY_SECRET=

# Email Configuration (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM="Shark Funded" <no-reply@sharkfunded.com>

# App Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000/
MAINTENANCE_MODE=false
