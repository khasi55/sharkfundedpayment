{
    "info": {
        "_postman_id": "sharkfunded-collection-id",
        "name": "SharkFunded API",
        "description": "API Collection for SharkFunded payment gateway and admin functions.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "System Status",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/api/system-status",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "system-status"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Create Order",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Basic {{auth_token}}",
                        "type": "text",
                        "description": "Base64 encoded keyId:keySecret"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"amount\": 1000,\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"callback_url\": \"https://example.com/callback\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/create-order",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "create-order"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Verify Payment",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"utr\": \"123456789012\",\n    \"amount\": 1000,\n    \"email\": \"john@example.com\",\n    \"name\": \"John Doe\",\n    \"orderId\": \"optional-order-id\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/verify-payment",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "verify-payment"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Payment Webhook (Simulate)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"from\": \"BankSMS\",\n    \"text\": \"Credited Rs. 1000.00 to logic. UTR: 123456789012\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/payment-webhook",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "payment-webhook"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Send Receipt",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"utr\": \"123456789012\",\n    \"email\": \"john@example.com\",\n    \"name\": \"John Doe\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/send-receipt",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "send-receipt"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Update Status (Admin)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"transactionId\": \"uuid-transaction-id\",\n    \"status\": \"verified\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/admin/update-status",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "admin",
                        "update-status"
                    ]
                }
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "auth_token",
            "value": "YOUR_BASE64_ENCODED_CREDENTIALS",
            "type": "string"
        }
    ]
}